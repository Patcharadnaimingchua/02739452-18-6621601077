# คัดลอกเป็น .env แล้วแก้รหัสผ่าน:  cp .env.example .env
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_db
AQ_DB_NAME=airquality
# Postgres port exposed on the host (container still uses 5432)
POSTGRES_HOST_PORT=5433

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin

# Data sources (เปลี่ยน URL ให้ผิดเพื่อทดสอบกรณีแหล่งล่ม)
AIR4THAI_URL=https://air4thai.pcd.go.th/services/getNewAQI_JSON.php
OPENMETEO_URL=https://air-quality-api.open-meteo.com/v1/air-quality
AQICN_BASE_URL=https://aqicn.org
# OpenAQ v3 ต้องใช้ key (ไม่ได้ใช้ในเวอร์ชันนี้ — ใช้ Open-Meteo แทน) ห้าม commit key จริง
OPENAQ_API_KEY=

# Scraping politeness
SCRAPE_MAX_PAGES=40
SCRAPE_DELAY_SEC=1.0

# Data quality thresholds
QUALITY_MIN_ROWS=100
QUALITY_MAX_NULL_RATIO=0.30
